+          document.getElementById('storage').textContent = 'Storage failed — changes may be lost on reload';
+          notify('Browser storage could not save your data. Check available space and site storage permissions.');
+        }
+        if (/SCRIPT ERROR|Parse Error|Failed to instantiate|Failed to load script/.test(message)) fail(message);
+      },
+      onExit(code) {
+        ready = false;
+        loading.hidden = false;
+        detail.textContent = code === 0 ? 'The game has closed.' : `The game exited with code ${code}.`;
+        retry.hidden = false;
+      }
+    });
+    if (!ready && !failed) detail.textContent = 'Loading the main menu…';
+  } catch (error) {
+    fail(error);
+  }
+});
+</script>
