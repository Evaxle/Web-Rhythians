+extends RefCounted
+
+var bytes:PackedByteArray
+var pos:int = 0
+var error:String = ""
+
+func take(size:int) -> PackedByteArray:
+	if size < 0 or size > bytes.size() - pos:
+		error = "The map file is truncated or contains invalid offsets."
+		return PackedByteArray()
+	var result = bytes.slice(pos, pos + size)
+	pos += size
+	return result
+
+func number(size:int) -> int:
+	var value = take(size)
+	if value.size() != size: return 0
+	match size:
+		1: return value[0]
+		2: return value.decode_u16(0)
+		4: return value.decode_u32(0)
+		8: return value.decode_u64(0)
+	return 0
+
+func jump(offset:int):
+	if offset < 0 or offset > bytes.size():
+		error = "The map contains an invalid section offset."
+		return
+	pos = offset
+
+func text16() -> String:
+	return take(number(2)).get_string_from_utf8()
+
+func line() -> String:
+	var start = pos
+	while pos < bytes.size() and bytes[pos] != 10 and pos - start < 65536:
+		pos += 1
+	if pos == bytes.size() or pos - start >= 65536:
+		error = "The map has invalid metadata."
+		return ""
+	var value = bytes.slice(start, pos).get_string_from_utf8().strip_edges()
+	pos += 1
+	return value
+
+func position():
+	var mode = number(1)
+	if mode == 0:
+		take(2)
+	elif mode == 1:
+		var point = take(8)
+		if point.size() == 8 and (not is_finite(point.decode_float(0)) or not is_finite(point.decode_float(4))):
+			error = "The map contains invalid note positions."
+	else:
+		error = "The map contains an invalid position type."
+
+func field(type:int, depth:int = 0):
+	if not error.is_empty(): return
+	if depth > 8:
+		error = "The map metadata is nested too deeply."
+		return
+	match type:
+		1: take(1)
+		2: take(2)
+		3, 5: take(4)
+		4, 6: take(8)
+		7: position()
+		8, 9: take(number(2))
+		10, 11: take(number(4))
+		12:
+			var element_type = number(1)
+			var count = number(2)
+			for i in count:
+				field(element_type, depth + 1)
+				if not error.is_empty(): return
+		_: error = "The map uses an unsupported metadata type."
+
+func validate(data:PackedByteArray) -> String:
+	bytes = data
+	pos = 0
+	error = ""
+	if bytes.size() < 16 or take(4) != PackedByteArray([83, 83, 43, 109]):
+		return "This is not a valid SSPM file."
+	var version = number(2)
+	if version == 1: v1()
+	elif version == 2: v2()
+	else: return "Only SSPM versions 1 and 2 are supported."
+	return error
+
+func v1():
+	take(2)
+	if line().is_empty(): error = "The map has no ID."
+	line()
+	line()
+	take(4)
+	var count = number(4)
+	if count < 1 or count > 1000000:
+		error = "The map must contain between 1 and 1,000,000 notes."
+		return
+	number(1)
+	var cover = number(1)
+	if cover == 1:
+		var height = number(2)
+		var width = number(2)
+		take(2)
+		var size = number(8)
+		if width > 4096 or height > 4096 or size > 67108864:
+			error = "The map cover is too large."
+			return
+		take(size)
+	elif cover == 2: take(number(8))
+	elif cover != 0: error = "The map has an invalid cover type."
+	if number(1) != 1:
+		error = "The map needs embedded audio to play in the browser."
+		return
+	var audio_size = number(8)
+	if audio_size < 12: error = "The map audio is missing."
+	take(audio_size)
+	for i in count:
+		if not error.is_empty(): return
+		take(4)
+		position()
+
+func v2():
+	jump(0x26)
+	var count = number(4)
+	if count < 1 or count > 1000000:
+		error = "The map must contain between 1 and 1,000,000 markers."
+		return
+	take(3)
+	if number(1) != 1:
+		error = "The map needs embedded audio to play in the browser."
+		return
+	var has_cover = number(1)
+	jump(0x40)
+	var audio_offset = number(8)
+	var audio_size = number(8)
+	var cover_offset = number(8)
+	var cover_size = number(8)
+	var definition_offset = number(8)
+	jump(0x70)
+	var marker_offset = number(8)
+	jump(0x80)
+	if text16().is_empty(): error = "The map has no ID."
+	text16()
+	text16()
+	for i in number(2): text16()
+	for i in number(2):
+		text16()
+		field(number(1))
+		if not error.is_empty(): return
+	jump(audio_offset)
+	if audio_size < 12: error = "The map audio is missing."
+	take(audio_size)
+	if has_cover:
+		jump(cover_offset)
+		take(cover_size)
+	jump(definition_offset)
+	var types:Array = []
+	var note_type:int = -1
+	for i in number(1):
+		var label = text16()
+		var values:Array = []
+		for j in number(1): values.append(number(1))
+		if number(1) != 0: error = "The map has invalid marker definitions."
+		if label == "ssp_note" and not values.is_empty() and values[0] == 7: note_type = i
+		types.append(values)
+	if note_type < 0:
+		error = "The map contains no supported notes."
+		return
+	jump(marker_offset)
+	var notes = 0
+	for i in count:
+		if not error.is_empty(): return
+		take(4)
+		var type = number(1)
+		if type >= types.size():
+			error = "The map contains an invalid marker type."
+			return
+		if type == note_type: notes += 1
+		for value in types[type]: field(value)
+	if notes == 0: error = "The map contains no notes."
