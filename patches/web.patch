+	jump(0x70)
+	var marker_offset = number(8)
+	jump(0x80)
+	if text16().is_empty(): error = "The map has no ID."
+	text16()
+	text16()
+	for i in number(2): text16()
+	for i in number(2):
+		text16()
+		field(number(1))
+		if not error.is_empty(): return
+	jump(audio_offset)
+	if audio_size < 12: error = "The map audio is missing."
+	audio = take(audio_size)
+	if has_cover:
+		jump(cover_offset)
+		take(cover_size)
+	jump(definition_offset)
