+<script>
+const config = $GODOT_CONFIG;
+config.persistentPaths = ['/userfs'];
+const engine = new Engine(config);
+const loading = document.getElementById('loading');
+const start = document.getElementById('start');
+const progress = document.getElementById('progress');
+const detail = document.getElementById('detail');
+const retry = document.getElementById('retry');
+let ready = false;
+let failed = false;
+let importBusy = false;
+let importResolve;
+let messageTimer;
+const importButton = document.getElementById('import');
+const fileInput = document.getElementById('files');
+function notify(message) {
+  const box = document.getElementById('message');
+  box.textContent = message;
+  box.hidden = false;
+  clearTimeout(messageTimer);
+  messageTimer = setTimeout(() => { box.hidden = true; }, 10000);
+}
+window.rhythiaImportResult = text => {
+  const result = JSON.parse(text);
+  notify(result.message);
+  if (importResolve) {
+    importResolve(result);
+    importResolve = undefined;
+  }
+};
+importButton.addEventListener('click', () => fileInput.click());
+async function importFiles(files) {
+  if (importBusy || !ready) return;
+  importBusy = true;
+  importButton.disabled = true;
+  try {
+    for (const file of files) {
+      if (file.size > 128 * 1024 * 1024) { notify('Maps must be smaller than 128 MiB.'); continue; }
+      const data = await file.arrayBuffer();
+      await new Promise(resolve => {
+        importResolve = resolve;
+        window.rhythiaImport(file.name, data);
+      });
+    }
+  } catch (error) {
+    notify('Import failed: ' + error.message);
+  } finally {
+    importResolve = undefined;
+    importBusy = false;
+    importButton.disabled = false;
+    fileInput.value = '';
+  }
+}
+fileInput.addEventListener('change', () => importFiles(Array.from(fileInput.files)));
+window.addEventListener('dragover', event => event.preventDefault());
+window.addEventListener('drop', event => {
+  event.preventDefault();
+  if (!ready) notify('Launch the game before dropping a map.');
+  else if (event.target !== document.getElementById('canvas')) importFiles(Array.from(event.dataTransfer.files));
+});
+
+function fail(error) {
+  if (ready || failed) return;
+  failed = true;
+  detail.textContent = 'Could not load the game: ' + (error.message || String(error));
+  progress.hidden = true;
+  start.hidden = true;
+  retry.hidden = false;
+  console.error(error);
+}
+
+retry.addEventListener('click', () => location.reload());
+window.addEventListener('rhythia-game', () => { document.getElementById('tools').hidden = true; });
+window.addEventListener('rhythia-ready', () => {
+  if (failed) return;
+  ready = true;
+  document.getElementById('tools').hidden = false;
+  document.getElementById('storage').textContent = window.rhythiaStoragePersistent ? 'Maps and settings saved in this browser' : 'Storage unavailable — data will be lost on reload';
+  document.body.dataset.gameState = 'ready';
+  loading.hidden = true;
+  document.getElementById('canvas').focus();
+});
+window.addEventListener('error', event => fail(event.error || event.message));
+window.addEventListener('unhandledrejection', event => fail(event.reason));
+start.addEventListener('click', async () => {
+  start.disabled = true;
+  try {
+    const missing = Engine.getMissingFeatures({ threads: $GODOT_THREADS_ENABLED });
+    if (missing.length) throw new Error(missing.join(', ') + '. Enable hardware acceleration or try a browser with WebGL 2 support.');
+    progress.hidden = false;
+    start.hidden = true;
+    detail.textContent = 'Downloading game…';
+    await engine.startGame({
+      onProgress(current, total) {
+        if (total > 0) {
+          progress.max = total;
+          progress.value = current;
+          detail.textContent = current < total ? `Downloading game… ${Math.round(current / total * 100)}%` : 'Starting Rhythia…';
+        }
+      },
+      onPrintError(...args) {
+        const message = args.join(' ');
+        console.error(message);
+        if (/Failed to save IDB|IndexedDB not available/i.test(message)) {
+          document.getElementById('storage').textContent = 'Storage failed — changes may be lost on reload';
+          notify('Browser storage could not save your data. Check available space and site storage permissions.');
+        }
+        if (/SCRIPT ERROR|Parse Error|Failed to instantiate|Failed to load script/.test(message)) fail(message);
+      },
+      onExit(code) {
+        ready = false;
+        loading.hidden = false;
+        detail.textContent = code === 0 ? 'The game has closed.' : `The game exited with code ${code}.`;
+        retry.hidden = false;
+      }
+    });
+    if (!ready && !failed) detail.textContent = 'Loading the main menu…';
+  } catch (error) {
+    fail(error);
+  }
+});
+</script>
+</body>
+</html>
