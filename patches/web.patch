+extends Node
+
+const SspmCheck = preload("res://scripts/web/SspmCheck.gd")
+const MAX_MAP_BYTES = 134217728
+signal maps_changed
+var import_callback:JavaScriptObject
+var browser_window:JavaScriptObject
+
+func _ready():
+	if not OS.has_feature("web"): return
+	load_profiles()
+	get_window().files_dropped.connect(_files_dropped)
+	browser_window = JavaScriptBridge.get_interface("window")
+	import_callback = JavaScriptBridge.create_callback(_browser_import)
+	browser_window.rhythiaImport = import_callback
+	browser_window.rhythiaStoragePersistent = OS.is_userfs_persistent()
+	profile_callback = JavaScriptBridge.create_callback(_profile_command)
+	browser_window.rhythiaProfile = profile_callback
+	editor_callback = JavaScriptBridge.create_callback(_editor_command)
+	browser_window.rhythiaEditor = editor_callback
+	browser_window.rhythiaProfilesJSON = JSON.stringify(profiles)
+
+func _browser_import(args:Array):
+	if args.size() != 2 or not JavaScriptBridge.is_js_buffer(args[1]): return
+	var result = import_map(str(args[0]), JavaScriptBridge.js_buffer_to_packed_byte_array(args[1]))
+	browser_window.rhythiaImportResult(JSON.stringify(result))
+
+func _files_dropped(files:PackedStringArray):
+	for path in files:
+		var file = FileAccess.open(path, FileAccess.READ)
+		var result:Dictionary
+		if file == null:
+			result = {"ok": false, "message": "Could not open the dropped file."}
+		elif file.get_length() > MAX_MAP_BYTES:
+			result = {"ok": false, "message": "Maps must be smaller than 128 MiB."}
+		else:
+			result = import_map(path.get_file(), file.get_buffer(file.get_length()))
+		if file: file.close()
+		if browser_window: browser_window.rhythiaImportResult(JSON.stringify(result))
+
+func import_map(filename:String, data:PackedByteArray) -> Dictionary:
+	if Rhythia.loading or Rhythia.is_init:
+		return {"ok": false, "message": "Wait for the map menu before importing."}
+	if get_tree().current_scene and get_tree().current_scene.get_meta("is_game", false):
+		return {"ok": false, "message": "Return to the menu before importing maps."}
+	if filename.get_extension().to_lower() != "sspm":
+		return {"ok": false, "message": "Choose an .sspm map file."}
+	if data.size() > MAX_MAP_BYTES:
+		return {"ok": false, "message": "Maps must be smaller than 128 MiB."}
+	var validation = SspmCheck.new().validate(data)
+	if not validation.is_empty(): return {"ok": false, "message": validation}
+	var hash = HashingContext.new()
+	hash.start(HashingContext.HASH_SHA256)
+	hash.update(data)
+	var target = Globals.Paths.maps.path_join(hash.finish().hex_encode() + ".sspm")
+	if FileAccess.file_exists(target):
+		open_editor(target)
+		return {"ok": true, "message": "Opened imported map."}
+	var staged = Globals.Paths.user.path_join("import.tmp")
+	var file = FileAccess.open(staged, FileAccess.WRITE)
+	if file == null: return {"ok": false, "message": "Browser storage could not save this map."}
+	file.store_buffer(data)
+	file.close()
+	var mapset = Mapset.read_from_file(staged, true)
+	if mapset == null or mapset.broken or mapset.maps.is_empty() or mapset.maps[0].notes.is_empty() or mapset.audio == null or mapset.audio.get_length() <= 0:
+		DirAccess.remove_absolute(staged)
+		return {"ok": false, "message": "The map has no playable notes or its audio cannot be decoded."}
+	if Rhythia.mapsets.get_by_id(mapset.id) != null:
+		DirAccess.remove_absolute(staged)
+		open_editor(Rhythia.mapsets.get_by_id(mapset.id).path)
+		return {"ok": true, "message": "Opened existing map with this ID."}
+	if DirAccess.rename_absolute(staged, target) != OK:
+		DirAccess.remove_absolute(staged)
+		return {"ok": false, "message": "Browser storage could not finish saving this map."}
+	mapset.path = target
+	Rhythia.mapsets.add_item(Mapset.read_from_file(target))
+	maps_changed.emit()
+	open_editor(target, mapset)
+	if OS.has_feature("web"): JavaScriptBridge.force_fs_sync()
+	return {"ok": true, "message": "Imported " + mapset.name + "."}
+
+var profiles:Dictionary = {"active": "default", "items": [{"id": "default", "name": "Default"}]}
+var profile_callback:JavaScriptObject
+var editor_callback:JavaScriptObject
+var editor_path:String = ""
+var editor_map:Mapset
+
+func load_profiles():
+	var path = Globals.web_root.path_join("profiles.json")
+	if FileAccess.file_exists(path):
+		var saved = JSON.parse_string(FileAccess.get_file_as_string(path))
+		if saved is Dictionary and saved.get("items") is Array and saved.get("active") is String:
+			var clean:Array = []
+			for item in saved.items:
+				if item is Dictionary and item.get("id") is String and item.get("name") is String:
+					if item.id == "default" or (item.id.length() == 32 and item.id.is_valid_hex_number()): clean.append(item)
+			if not clean.is_empty(): profiles = {"items": clean, "active": saved.active}
+	var found = false
+	for item in profiles.items:
+		if item.id == profiles.active: found = true
+	if not found: profiles.active = profiles.items[0].id
+	Globals.active_profile = profiles.active
+	Globals.update_paths()
+
+func save_profiles() -> bool:
+	var file = FileAccess.open(Globals.web_root.path_join("profiles.json"), FileAccess.WRITE)
+	if file == null: return false
+	file.store_string(JSON.stringify(profiles))
+	file.close()
+	if OS.has_feature("web"): JavaScriptBridge.force_fs_sync()
+	return true
+
+func create_profile(label:String) -> String:
+	label = label.strip_edges().left(40)
+	if label.is_empty() or profiles.items.size() >= 32: return ""
+	for item in profiles.items:
+		if item.name.to_lower() == label.to_lower(): return ""
+	var id = Crypto.new().generate_random_bytes(16).hex_encode()
+	profiles.items.append({"id": id, "name": label})
+	if not save_profiles():
+		profiles.items.pop_back()
+		return ""
+	return id
+
+func switch_profile(id:String) -> bool:
+	if Rhythia.loading or Rhythia.is_init: return false
+	if get_tree().current_scene and get_tree().current_scene.get_meta("is_game", false): return false
+	var found = false
+	for item in profiles.items:
+		if item.id == id: found = true
+	if not found: return false
+	Rhythia.save_settings()
+	var previous = profiles.active
+	profiles.active = id
+	if not save_profiles():
+		profiles.active = previous
+		return false
+	Globals.active_profile = id
+	Globals.update_paths()
+	Rhythia.load_settings()
+	Rhythia.playlists.clear()
+	Rhythia._load_playlists()
+	editor_map = null
+	editor_path = ""
+	return true
+
+func _profile_command(args:Array):
+	if args.size() < 1: return
+	var request = JSON.parse_string(str(args[0]))
+	if not request is Dictionary: return
+	if request.get("action") == "flush":
+		Rhythia.save_settings()
+		return
+	var id = str(request.get("id", ""))
+	if request.get("action") == "create": id = create_profile(str(request.get("name", "")))
+	var ok = switch_profile(id)
+	browser_window.rhythiaProfileResult(JSON.stringify({"ok": ok, "profiles": profiles}))
+	if ok: get_tree().change_scene_to_file("res://scenes/Menu.tscn")
+
+func open_editor(path:String, loaded:Mapset = null):
+	if not browser_window: return
+	editor_path = path
+	editor_map = loaded if loaded != null else Mapset.read_from_file(path, true)
+	send_editor_page(0)
+
+func send_editor_page(page:int):
+	if editor_map == null: return
+	var notes = editor_map.maps[0].notes
+	page = clampi(page, 0, maxi(0, (notes.size() - 1) / 100))
+	var rows:Array = []
+	for i in range(page * 100, mini(notes.size(), (page + 1) * 100)):
+		var note = notes[i]
+		rows.append({"index": i, "time": note.time, "x": note.x, "y": note.y})
+	browser_window.rhythiaEditorPage(JSON.stringify({"name": editor_map.name, "count": notes.size(), "page": page, "rows": rows}))
+
+func save_editor_copy(edits:Dictionary) -> Dictionary:
+	if editor_map == null or edits.size() > 10000: return {"ok": false, "message": "Open a map first; save at most 10,000 edits at a time."}
+	var validator = SspmCheck.new()
+	if not validator.validate(FileAccess.get_file_as_bytes(editor_path)).is_empty(): return {"ok": false, "message": "The source map is unavailable."}
+	var notes = editor_map.maps[0].notes
+	for key in edits:
+		var i = str(key).to_int()
+		var edit = edits[key]
+		if str(i) != str(key) or i < 0 or i >= notes.size() or not edit is Dictionary: return {"ok": false, "message": "Invalid note index."}
+		for field in ["time", "x", "y"]:
+			if not (edit.get(field) is float or edit.get(field) is int) or not is_finite(float(edit[field])): return {"ok": false, "message": "Note values must be finite numbers."}
+		if edit.time < 0 or edit.time > 4294967 or absf(edit.x) > 1000 or absf(edit.y) > 1000: return {"ok": false, "message": "Note values are outside supported limits."}
+	var buffer = StreamPeerBuffer.new()
+	buffer.big_endian = false
+	buffer.put_data("SS+m".to_ascii_buffer())
+	buffer.put_u16(1)
+	buffer.put_u16(0)
+	var id = editor_map.id + "-edit-" + Crypto.new().generate_random_bytes(8).hex_encode()
+	for label in [id, editor_map.name + " (edited)", editor_map.creator]:
+		buffer.put_data((str(label).replace("\n", " ").replace("\r", " ") + "\n").to_utf8_buffer())
+	buffer.put_u32(int(editor_map.length * 1000))
+	buffer.put_u32(notes.size())
+	buffer.put_u8(0)
+	buffer.put_u8(0)
+	buffer.put_u8(1)
+	buffer.put_u64(validator.audio.size())
+	buffer.put_data(validator.audio)
+	for i in notes.size():
+		var note = notes[i]
+		var edit = edits.get(str(i), {"time": note.time, "x": note.x, "y": note.y})
+		buffer.put_u32(roundi(edit.time * 1000))
+		buffer.put_u8(1)
+		buffer.put_float(edit.x)
+		buffer.put_float(edit.y)
+	return import_map(id + ".sspm", buffer.data_array)
+
+func _editor_command(args:Array):
+	if args.size() < 1: return
+	var request = JSON.parse_string(str(args[0]))
+	if not request is Dictionary: return
+	if request.get("action") == "page": send_editor_page(int(request.get("page", 0)))
+	elif request.get("action") == "close":
+		editor_map = null
+		editor_path = ""
+	elif request.get("action") == "save" and request.get("edits") is Dictionary:
+		var result = save_editor_copy(request.edits)
+		browser_window.rhythiaEditorSaved(JSON.stringify(result))
